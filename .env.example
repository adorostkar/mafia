NODE_ENV=development
HOST=127.0.0.1
PORT=3001
DATABASE_PATH=./data/mafia.sqlite

# Set the exact HTTPS origin in production, with no trailing slash.
PUBLIC_ORIGIN=

# Comma-separated trusted proxy addresses or CIDRs. Leave empty without a proxy.
TRUST_PROXY=

# Optional: set BOTH values to require verified email for new accounts.
# Leave both empty for recovery-code mode. Never use VITE_ for secrets.
RESEND_API_KEY=
EMAIL_FROM=
